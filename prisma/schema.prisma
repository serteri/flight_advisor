generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 💳 ÖDEME SİSTEMİ (STRIPE)
  stripeCustomerId       String?   @unique // Stripe'daki ID'si
  stripeSubscriptionId   String?   // Aktif abonelik ID'si (upsert idempotency için non-unique)
  stripePriceId          String?   // Hangi paketi aldı?
  stripeCurrentPeriodEnd DateTime? // Abonelik ne zaman bitiyor?
  subscriptionStatus     String?   // trialing, active, canceled
  trialEndsAt            DateTime? // Deneme bitiş tarihi
  trialReminderSentAt    DateTime? // Trial bitiş hatirlatma gonderim zamani
  
  isPremium              Boolean   @default(false) // Hızlı kontrol için
  
  // 🔔 NOTIFICATION PREFERENCES
  subscriptionPlan      String    @default("FREE") // FREE, PRO, ELITE
  notificationTone      String    @default("STANDARD") // STANDARD, JUNIOR_GUARDIAN
  phoneNumber           String?   // +90... for SMS
  telegramId            String?   // For Telegram alerts
  pushToken             String?   // Mobile push notifications
  
  routes          Route[]
  accounts        Account[]
  sessions        Session[]
  watchedFlights  WatchedFlight[]
  monitors        Monitor[]
  monitoredTrips  MonitoredTrip[]
  preferences     UserPreference[]
  alertEvents     AlertEvent[]
  
  // 🧪 EXPERIMENT ASSIGNMENTS
  experimentAssignments ExperimentAssignment[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

model Route {
  id        String   @id @default(cuid())
  userId    String
  originCode      String
  destinationCode String
  startDate DateTime
  endDate   DateTime?
  tripType  String   @default("ONE_WAY")
  cabin     CabinClass   @default(ECONOMY)
  maxStops  Int?
  targetPrice Float?
  baggageRequired Boolean?
  preferredAirlines String[] @default([])
  active    Boolean  @default(true)
  trendStatus String? @default("UNKNOWN")
  timingSignal String? @default("WATCH_CLOSELY")
  timingReason String?
  latestSnapshotAt DateTime?
  lastSignalAt DateTime?
  
  // Anomaly Detection Cache
  currentPrice     Float?
  stats_mean       Float?
  stats_stdDev     Float?
  stats_lastUpdated DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceSnapshots    PriceSnapshot[]
  alertLogs    AlertLog[]
  alertEvents  AlertEvent[]

  @@index([userId])
  @@index([originCode, destinationCode])
}

model PriceSnapshot {
  id          String   @id @default(cuid())
  routeId     String
  provider    String   @default("Skyscanner")
  amount      Float
  currency    String   @default("TRY")
  timestamp   DateTime @default(now()) // alias for collectedAt

  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  // Flight Scoring & Details
  score     Float?   // 1.0 - 10.0 Quality Score
  explanation String?  // Reason for selection
  duration    Int?     // Total minutes
  stops       Int?     // Number of stops
}

model AlertLog {
  id        String   @id @default(cuid())
  routeId   String
  message   String
  score     Float?       // 1.0 - 10.0 Quality Score
  oldPrice  Float?
  newPrice  Float?
  dropPercent Float?
  isRead    Boolean  @default(false)
  sentAt    DateTime @default(now()) // alias for createdAt

  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

enum AirportType {
  DOMESTIC
  INTERNATIONAL
  REGIONAL
}

model Airport {
  id        String   @id @default(cuid())
  cityId    String
  code      String   // IATA code
  name      String   // Airport name
  isMajor   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@index([code])
}

model City {
  id        String    @id @default(cuid())
  name      String
  country   String
  airports  Airport[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

// ----------------------------
// HISTORICAL SEARCH DATA
// ----------------------------

// 🔥 YENİ: ORACLE'IN HAFIZASI (Route Benchmark)
model RouteStatistics {
  id              String   @id @default(cuid())
  originCode      String   // BNE
  destinationCode String   // IST
  month           Int      // 1-12 (Mevsimsellik için)
  
  // İstatistikler
  minPrice        Float    // Bugüne kadar görülmüş en düşük fiyat
  maxPrice        Float    // Bugüne kadar görülmüş en yüksek fiyat
  avgPrice        Float    // Hareketli Ortalama (Moving Average)
  
  sampleSize      Int      // Kaç arama üzerinden hesaplandı? (Güven skoru için)
  
  lastUpdated     DateTime @updatedAt

  // Aynı rota ve ay için tek kayıt olsun (BNE-IST-Haziran)
  @@unique([originCode, destinationCode, month])
  @@index([originCode, destinationCode])
}

// 🗂️ ARAMA GEÇMİŞİ (Kullanıcı için)
model SearchHistory {
  id              String   @id @default(cuid())
  userId          String?  // Anonim de olabilir
  originCode      String
  destinationCode String
  departureDate   DateTime
  
  // Sonuçların özetini buraya gömelim (Join yapmaya gerek kalmasın)
  bestPrice       Float?   // O anki en ucuz
  bestDuration    Int?     // O anki en hızlı
  
  createdAt       DateTime @default(now())

  // Ham sonuçları (SearchResult) saklamak zorunda değiliz.
}

model FlightSearchRecord {
  id                   String    @id @default(cuid())
  flightNumber         String
  origin               String
  destination          String
  departureDate        DateTime
  price                Float
  provider             String
  airlineName          String?
  airlineCode          String?
  stops                Int?
  totalDurationMinutes Int?
  layoverAirports      String[]  @default([])
  departureTime        DateTime?
  arrivalTime          DateTime?
  rawResponse          Json?
  cacheStatus          String?   @default("SUCCESS")
  createdAt            DateTime  @default(now())

  @@index([origin, destination, departureDate])
  @@index([flightNumber, departureDate])
  @@index([provider, cacheStatus, createdAt])
  @@index([createdAt])
}

model SearchAnalytics {
  id              String   @id @default(cuid())
  origin          String
  destination     String
  departureDate   DateTime
  minPrice        Float
  avgPrice        Float
  foundMinPrice   Float    @default(0)
  foundAvgPrice   Float    @default(0)
  provider        String
  searchTimestamp DateTime @default(now())
  selectionAction String?
  selectionVariant String?
  decisionRecommendation String?
  decisionConfidence Int?
  selectedPrice   Float?

  @@index([origin, destination, departureDate])
  @@index([provider, searchTimestamp])
  @@index([searchTimestamp])
  @@index([selectionVariant, selectionAction])
}

model RouteInsight {
  id             String   @id @default(cuid())
  origin         String
  destination    String
  departureDate  DateTime
  searchCount    Int      @default(0)
  lastMinPrice   Float
  lastAvgPrice   Float
  avgPriceRoute  Float    @default(0)
  observedMinPrice Float
  observedMaxPrice Float
  rollingAvgPrice Float
  recommendedBookingWindowDays Int?
  lastObservedDaysToDeparture Int?
  bookingWindowPattern Json?
  volatility     Float    @default(0)
  lastSearchedAt DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([origin, destination, departureDate])
  @@index([origin, destination])
  @@index([departureDate, lastSearchedAt])
}

model FlightSelectionEvent {
  id                String   @id @default(cuid())
  action            String
  flightId          String?
  flightNumber      String?
  provider          String?
  origin            String?
  destination       String?
  departureDate     DateTime?
  selectedPrice     Float?
  selectedScore     Float?
  competitorPrice   Float?
  competitorScore   Float?
  rank              Int?
  totalResults      Int?
  currency          String?
  
  // 🧪 A/B TESTING
  experimentId      String?   // Which experiment (if any)
  variantId         String?   // Which variant within experiment
  
  // 🎯 DECISION CONTEXT
  decisionRecommendation String?  // BUY_NOW, WAIT, AVOID
  decisionConfidence     Int?     // 0-100
  
  createdAt         DateTime @default(now())

  @@index([action, createdAt])
  @@index([origin, destination, departureDate])
  @@index([experimentId, variantId])
  @@index([decisionRecommendation])
}

model UserPreference {
  id                String   @id @default(cuid())
  userId            String?
  action            String
  airline           String?
  origin            String?
  destination       String?
  departureDate     DateTime?
  flightId          String?
  provider          String?
  selectedPrice     Float?
  selectedScore     Float?
  competitorPrice   Float?
  competitorScore   Float?
  isDirect          Boolean  @default(false)
  isNight           Boolean  @default(false)
  departureHour     Int?
  createdAt         DateTime @default(now())

  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([origin, destination, departureDate])
  @@index([isDirect, isNight, createdAt])
}

// ----------------------------
// WATCHED FLIGHTS (User Tracking)
// ----------------------------

model WatchedFlight {
  id            String   @id @default(cuid())
  userId        String?  // Optional: if auth is available
  flightNumber  String   // e.g., CZ382
  airline       String   // e.g., China Southern
  origin        String   // BNE
  destination   String   // IST
  departureDate DateTime // Flight departure date
  initialPrice  Float    // Price when tracking started
  currentPrice  Float?   // Latest checked price
  priceHistory  Json?    // [{"date": "2026-01-21", "price": 23595}]
  currency      String   @default("TRY")
  status        String   @default("ACTIVE") // ACTIVE, EXPIRED, BOUGHT
  lastChecked   DateTime?
  
  // Flight Details
  totalDuration Int?     // Total minutes
  stops         Int?     // Number of stops
  segments      Json?    // Full segment details: [{from, to, carrier, flightNumber, departure, arrival, duration}]
  layovers      Json?    // Layover info: [{airport, city, duration}]
  baggageWeight Int?     // Baggage allowance in kg
  cabin         String?  // ECONOMY, BUSINESS, etc.
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertEvents   AlertEvent[]

  @@index([userId])
  @@index([origin, destination])
  @@index([departureDate])
  @@index([status])
}

// ----------------------------
// TRAVEL GUARDIAN (Premium) - V1 Legacy
// ----------------------------

enum MonitorType {
  UPGRADE_SNIPER
  DISRUPTION_HUNTER
  EMPTY_SEAT
  SCHEDULE_GUARDIAN
  AMENITY_WATCHDOG
}

enum MonitorStatus {
  ACTIVE
  COMPLETED
  TRIGGERED
}

model Monitor {
  id              String        @id @default(cuid())
  userId          String
  pnr             String?       // Booking Reference
  flightNumber    String
  date            DateTime
  type            MonitorType
  status          MonitorStatus @default(ACTIVE)
  
  // Specific Data
  targetPrice     Float?        // For Upgrade Sniper
  originalSchedule Json?        // For Schedule Guardian: { dep, arr, duration }
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  claims          CompensationClaim[]

  @@index([userId])
  @@index([status])
}

enum ClaimType {
  DELAY
  CANCELLATION
  AMENITY
}

enum ClaimStatus {
  DRAFT
  SENT
  PAID
  REJECTED
}

model CompensationClaim {
  id              String      @id @default(cuid())
  monitorId       String?
  flightLegId     String?     @unique
  type            ClaimType?
  amount          Float?
  currency        String      @default("EUR")
  status          ClaimStatus @default(DRAFT)
  details         Json?       // detailed reason, flight context
  eligibilityStatus String?
  regulation      String?
  estimatedAmount Int?
  delayMinutes    Int?
  calculatedAt    DateTime    @default(now())
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  monitor         Monitor?    @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  flightLeg       FlightLeg?  @relation(fields: [flightLegId], references: [id], onDelete: Cascade)

  @@index([monitorId])
  @@index([flightLegId])
  @@index([eligibilityStatus])
}

// ----------------------------
// 🛡️ TRAVEL GUARDIAN V2 (SaaS ENGINE)
// ----------------------------
model MonitoredTrip {
  id              String   @id @default(cuid())
  userId          String
  
  // Trip Identity
  pnr             String
  routeLabel      String   // "BNE ➝ IST"
  
  // Finansal Veriler (Bilet Bazlı)
  originalPrice   Float
  currency        String   @default("AUD")
  ticketClass     String
  fareBasis       String?
  isRefundable    Boolean  @default(false)
  
  targetUpgradePrice Float?  // Max price willing to pay for upgrade

  // Aktif Modüller
  watchPrice      Boolean  @default(true)
  watchDelay      Boolean  @default(true)
  watchUpgrade    Boolean  @default(false)
  watchSeat       Boolean  @default(false)
  watchSchedule   Boolean  @default(true)

  // Worker
  status          TripStatus @default(ACTIVE)
  lastCheckedAt   DateTime?
  nextCheckAt     DateTime
  checkFrequency  Int        @default(60)
  processingLeaseId        String?
  processingLeaseExpiresAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  segments        FlightSegment[]
  flightLegs      FlightLeg[]
  passengers      Passenger[]
  alerts          GuardianAlert[]
  alertEvents     AlertEvent[]
  snapshot        TripSnapshot?
  deliveries      NotificationDelivery[]
  playbook        DisruptionPlaybook?

  @@index([userId])
  @@index([status, nextCheckAt])
  @@index([status, nextCheckAt, processingLeaseExpiresAt])
}

model Passenger {
  id            String   @id @default(cuid())
  tripId        String
  
  name          String
  type          String   // "ADULT", "CHILD", "INFANT"
  age           Int?
  
  // Relationship
  trip          MonitoredTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  @@index([tripId])
}

model FlightSegment {
  id            String   @id @default(cuid())
  tripId        String
  
  // Sıralama (1. uçak, 2. uçak...)
  segmentOrder  Int      @default(0)

  // Flight Identity
  airlineCode   String   // TK
  flightNumber  String   // 55
  
  // Route
  origin        String   // SIN
  destination   String   // IST
  
  // Times
  departureDate DateTime
  arrivalDate   DateTime
  
  // Aircraft Details
  aircraftType  String?  // "77W"
  
  // User Specifics
  userSeat      String?  // "24A"
  cabinClass    String?  // "ECONOMY"
  
  // Relationship
  trip          MonitoredTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model FlightLeg {
  id              String   @id @default(cuid())
  tripId          String
  flightNumber    String
  origin          String
  destination     String
  scheduledDep    DateTime
  scheduledArr    DateTime
  actualDep       DateTime?
  actualArr       DateTime?
  carrier         String
  distanceKm      Int?
  regulationZone  String
  createdAt       DateTime @default(now())

  trip            MonitoredTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  compensationClaim CompensationClaim?

  @@index([tripId])
  @@index([origin, destination])
  @@index([flightNumber, scheduledDep])
  @@index([regulationZone])
}

model ConnectionCache {
  id           String   @id @default(cuid())
  flightIdent  String
  analysisDate DateTime @db.Date
  historyData  Json
  onTimeRate   Float
  sampleSize   Int
  expiresAt    DateTime

  @@unique([flightIdent, analysisDate])
  @@index([expiresAt])
}

// NOT: GuardianAlert tablosunu da güncellememiz gerekecek çünkü artık alarm
// bir Trip'e değil, spesifik bir Segment'e (Uçağa) ait olabilir.
model GuardianAlert {
  id          String   @id @default(cuid())
  tripId      String
  
  // YENİ ALAN: Hangi uçakla ilgili? (Opsiyonel, genel alarm da olabilir)
  segmentId   String?  
  
  type        String   // DELAY, PRICE, SEAT, UPGRADE...
  title       String
  message     String
  severity    String   // INFO, WARNING, CRITICAL
  
  // Para değeri veya fırsat bilgisi
  potentialValue  String?  // "600 EUR", "Business Class", etc.
  actionLabel     String?  // "File Claim", "Swap Ticket", etc.
  
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  trip        MonitoredTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

enum AlertLifecycleState {
  DETECTED
  QUEUED
  SENT
  DELIVERED
  FAILED
  RETRYING
  EXPIRED
  SUPPRESSED
}

enum MonitoringEventType {
  PRICE_DROP
  PRICE_SPIKE
  TARGET_PRICE_REACHED
  ROUTE_STALE
  DELAY_DETECTED
  CANCELLATION_DETECTED
  GATE_CHANGE
  TERMINAL_CHANGE
  CONNECTION_RISK
  STATUS_UNAVAILABLE
  MONITORING_STALE
  PROVIDER_UNAVAILABLE
  CHECK_DELAYED
  MONITORING_RECOVERED
}

enum AlertSourceType {
  ROUTE_WATCH
  WATCHED_FLIGHT
  MONITORED_TRIP
  SYSTEM
}

enum AlertDeliveryChannel {
  EMAIL
  SMS
  PUSH
}

enum AlertDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RETRYING
  SUPPRESSED
}

model AlertEvent {
  id              String              @id @default(cuid())
  userId          String?
  routeId         String?
  watchedFlightId String?
  tripId          String?

  sourceType      AlertSourceType
  sourceId        String
  eventType       MonitoringEventType
  state           AlertLifecycleState @default(DETECTED)
  severity        String              @default("INFO")
  fingerprint     String
  fingerprintKey  String
  title           String
  message         String
  payload         Json?

  cooldownUntil   DateTime?
  suppressedById  String?
  suppressionReason String?

  detectedAt      DateTime            @default(now())
  queuedAt        DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?
  expiresAt       DateTime?
  recoveredAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  route           Route?              @relation(fields: [routeId], references: [id], onDelete: Cascade)
  watchedFlight   WatchedFlight?      @relation(fields: [watchedFlightId], references: [id], onDelete: Cascade)
  trip            MonitoredTrip?      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  deliveries      AlertNotificationDelivery[]

  @@index([userId, detectedAt])
  @@index([sourceType, sourceId, eventType, detectedAt])
  @@index([state, detectedAt])
  @@index([fingerprintKey, detectedAt])
}

model AlertNotificationDelivery {
  id                String              @id @default(cuid())
  alertEventId      String
  channel           AlertDeliveryChannel
  status            AlertDeliveryStatus @default(QUEUED)
  attempt           Int                 @default(0)
  maxAttempts       Int                 @default(4)
  providerMessageId String?
  lastError         String?
  nextRetryAt       DateTime?
  queuedAt          DateTime            @default(now())
  attemptedAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  alertEvent        AlertEvent          @relation(fields: [alertEventId], references: [id], onDelete: Cascade)

  @@index([alertEventId])
  @@index([status, nextRetryAt])
  @@index([channel, status])
}

enum TripStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

// Persisted monitoring state — replaces in-memory lastAlertState.
// One row per trip, upserted after each worker cycle.
model TripSnapshot {
  id             String   @id @default(cuid())
  tripId         String   @unique

  delayMinutes   Int      @default(0)
  status         String   @default("scheduled")
  dataQuality    String   @default("UNKNOWN") // "HIGH", "LOW", "UNKNOWN"
  departureGate  String?
  arrivalGate    String?
  statusDetail   String?
  gateDetail     String?
  lastEventId    String?
  eu261Eligible  Boolean  @default(false)

  snapshotAt     DateTime @default(now()) @updatedAt

  trip           MonitoredTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// Ledger checking payload redundancies natively bypassing rapid crash iterations
model NotificationDelivery {
  id        String   @id @default(cuid())
  eventId   String
  tripId    String
  channel   String   // "EMAIL", "SMS"
  status    String   // "processing", "sent", "failed", "skipped"
  sentAt    DateTime?
  claimedAt DateTime?
  processingLeaseId        String?
  processingLeaseExpiresAt DateTime?
  attemptCount Int      @default(0)
  lastError   String?
  updatedAt   DateTime  @updatedAt

  trip      MonitoredTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  
  @@unique([eventId, channel])
  @@index([tripId])
  @@index([status, processingLeaseExpiresAt])
}

// 🔥 OPENCLAW SEARCH CACHE
model FlightOption {
  id              String   @id @default(uuid())
  origin          String
  destination     String
  date            DateTime

  // Temel Bilgiler
  airline         String
  flightNumber    String
  departureTime   DateTime
  arrivalTime     DateTime
  durationMinutes Int
  stops           Int

  // Para İşleri
  price           Float
  currency        String   @default("USD")

  // 🔥 YENİ EKLENEN RAFLAR (OpenClaw buraya veri koyacak)
  score           Float?   @default(0) // 8.9 Puan
  scoreReason     String?  // "Yemek sıcak diye puan verdim"

  // JSON formatında her şeyi saklayan sihirli kutular
  amenities       Json?    // { wifi: true, food: "Hot Meal", seatPitch: "81cm" }
  policies        Json?    // { refundable: true, baggageKg: 30 }

  createdAt       DateTime @default(now())
}
// =======================================================================================
// 🚀 SELF-OPTIMIZATION LAYER — A/B Testing, Accuracy, Auto-Tuning
// =======================================================================================

// 🧪 EXPERIMENT DEFINITIONS
model Experiment {
  id              String   @id @default(cuid())
  name            String   // "messaging-test-v1", "cta-wording-test"
  description     String?
  experimentType  String   // "MESSAGE", "CTA", "PAYWALL_TIMING", "RANKING_WEIGHT"
  status          String   @default("DRAFT") // DRAFT, RUNNING, PAUSED, COMPLETED
  
  // Timing
  startDate       DateTime?
  endDate         DateTime?
  
  // Targeting
  targetMetric    String   // "BOOKING_RATE", "CLICK_RATE", "TRACK_RATE"
  minSampleSize   Int      @default(100) // Stop experiment if not enough samples
  
  // Variants (stored as JSON for flexibility)
  variants        Json     // [{ id, name, config: {...} }, ...]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  assignments     ExperimentAssignment[]
  
  @@index([status])
  @@index([startDate, endDate])
}

// 👤 USER → VARIANT ASSIGNMENT
model ExperimentAssignment {
  id              String   @id @default(cuid())
  userId          String?
  sessionId       String?  // For anonymous users
  experimentId    String
  variantId       String   // Which variant in the experiment
  assigned        DateTime @default(now())
  
  experiment      Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  user            User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, experimentId])
  @@unique([sessionId, experimentId])
  @@index([experimentId])
}

// 📊 DECISION ACCURACY TRACKING
model DecisionAccuracy {
  id              String   @id @default(cuid())
  
  // Decision Context
  origin          String
  destination     String
  departureDate   DateTime
  decisionType    String   // "BUY_NOW", "WAIT", "AVOID"
  decisionConfidence Int   // 0-100 at time of decision
  
  // Price Tracking
  priceAtDecision Float    // Price when decision was made
  decidedAt       DateTime // When decision was made
  
  evaluatedAt     DateTime? // When accuracy was evaluated
  priceAtEvaluation Float?  // Price when evaluated
  priceChange     Float?   // priceAtEvaluation - priceAtDecision
  priceChangePercent Float? // ((priceAtEvaluation - priceAtDecision) / priceAtDecision) * 100
  
  // Accuracy Scoring
  isAccurate      Boolean? // Did the decision prove correct?
  accuracyScore   Int?     // 0-100: how accurate was the prediction?
  
  // Event Link
  eventId         String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([decisionType, isAccurate])
  @@index([origin, destination])
  @@index([createdAt])
}

// ⚙️ DECISION CONFIG (Runtime-updatable thresholds)
model DecisionConfig {
  id              String   @id @default(cuid())
  
  // Which decision type does this config apply to?
  decisionType    String   @unique // BUY_NOW, WAIT, AVOID
  
  // PRICE THRESHOLDS
  priceThresholdMin Float   @default(0.01)  // Min price position score for this decision
  priceThresholdMax Float   @default(0.30)  // Max price position score
  
  // TIME PRESSURE WEIGHTING
  timePressureWeight Float  @default(0.25)  // How much to weight urgency?
  
  // VOLATILITY SENSITIVITY
  volatilitySensitivity Float @default(0.15) // How much to weight price stability?
  
  // TREND CLARITY INFLUENCE
  trendClarityWeight Float   @default(0.20)  // How much to weight trend signal?
  
  // SAFE BOUNDS (prevent extreme swings)
  safetyBounds    Json     @default("{}")
    // {
    //   "minPrice": 0.001,
    //   "maxPrice": 1.0,
    //   "maxWeightChange": 0.05
    // }
  
  // Audit Trail
  version         Int      @default(1)
  updatedBy       String?  // User ID who updated
  updatedAt       DateTime @updatedAt
  appliedAt       DateTime? // When was this config actually applied to live?
  
  @@index([decisionType])
}

// 📈 DECISION PERFORMANCE METRICS (Aggregated funnel data)
model DecisionPerformanceMetric {
  id              String   @id @default(cuid())
  
  // Route + Time Window
  origin          String
  destination     String
  dateWindow      DateTime // Start of aggregation window (e.g., daily/weekly)
  
  decisionType    String   // BUY_NOW, WAIT, AVOID
  
  // Funnel Metrics
  shownCount      Int      @default(0) // How many times was this decision shown?
  clickCount      Int      @default(0) // How many clicked?
  bookCount       Int      @default(0) // How many actually booked? (BUY_NOW only)
  trackCount      Int      @default(0) // How many tracked? (WAIT only)
  ignoreCount     Int      @default(0) // How many ignored? (AVOID only)
  
  // Calculated Rates
  clickRate       Float    @default(0) // (clickCount / shownCount) * 100
  conversionRate  Float    @default(0) // (bookCount / shownCount) * 100
  trackRate       Float    @default(0) // (trackCount / shownCount) * 100
  ignoreRate      Float    @default(0) // (ignoreCount / shownCount) * 100
  
  // Accuracy Aggregate
  avgAccuracyScore Int?    // Average accuracyScore from DecisionAccuracy for this window
  accurateCount   Int      @default(0) // How many decisions were accurate?
  
  // Experiment Link (if part of A/B test)
  experimentId    String?
  variantId       String?
  
  updatedAt       DateTime @updatedAt
  
  @@unique([origin, destination, dateWindow, decisionType])
  @@index([origin, destination])
  @@index([dateWindow])
  @@index([experimentId])
}

// ─── DISRUPTION PLAYBOOK ─────────────────────────────────────────────────────
// Pre-generated "if X happens, do Y" scenario cards for a booked trip.
// Upserted at generation time; one record per MonitoredTrip.
model DisruptionPlaybook {
  id              String   @id @default(cuid())
  monitoredTripId String   @unique

  generatedAt     DateTime @default(now())

  // ScenarioCard objects serialised as JSON
  scenarioA       Json     // MissedConnection  (null when direct flight)
  scenarioB       Json     // SignificantDelay
  scenarioC       Json     // Cancellation

  airlineIata     String
  regulationZone  String   // EU261 | UK261 | DGCA | NONE
  connectionCount Int      @default(0)

  monitoredTrip   MonitoredTrip @relation(fields: [monitoredTripId], references: [id], onDelete: Cascade)

  @@index([monitoredTripId])
  @@index([airlineIata])
}

// 📬 LEAD CAPTURE — Email / waitlist sign-ups
model Lead {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?  // "landing_page", "exit_intent", "pricing_page", etc.
  createdAt DateTime @default(now())

  @@map("leads")
}
