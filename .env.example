# FlightAware AeroAPI key for server-side historical connection analysis.
FLIGHTAWARE_API_KEY=

# Aviationstack key for aircraft equipment/type lookups (Guardian Equipment
# Change detection). Quota-limited to 100 requests/month — dev/test always
# use mock data unless AVIATIONSTACK_FORCE_LIVE=true is also set.
AVIATIONSTACK_API_KEY=
AVIATIONSTACK_FORCE_LIVE=

# Shared secret required in INTERNAL_API_SECRET request header
# for /api/internal/health endpoints.
INTERNAL_API_SECRET=

# Stripe Checkout price IDs (required for /api/checkout)
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# Public Stripe key for client-side Stripe usage
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
