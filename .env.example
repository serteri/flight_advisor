# FlightAware AeroAPI key for server-side historical connection analysis.
FLIGHTAWARE_API_KEY=

# AeroDataBox via RapidAPI — the only flight-data provider (route, schedule,
# status, aircraft). Live calls happen only when VERCEL_ENV=production;
# development/preview use scenario mocks (lib/flightData/mock.ts) unless
# AERODATABOX_FORCE_LIVE=true. Live calls are always quota-guarded.
RAPID_API_KEY=
RAPID_API_HOST_AERODATABOX=aerodatabox.p.rapidapi.com
AERODATABOX_FORCE_LIVE=
# Monthly plan quota in API units, and units charged per flight-status call.
# RapidAPI x-ratelimit-* response headers override the internal counter.
AERODATABOX_MONTHLY_QUOTA=600
AERODATABOX_UNITS_PER_CALL=2

# Upstash QStash — delivers the per-trip monitoring checkpoints to
# /api/guardian/check. Required in Vercel production (fail-fast).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Outbound email provider: resend | mailjet (unset = resend). Only the selected
# provider's keys are required once EMAIL_DELIVERY_READY=true.
EMAIL_PROVIDER=
# Mailjet Send API v3.1 credentials (EMAIL_PROVIDER=mailjet).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Resend key for transactional email (EMAIL_PROVIDER=resend) (welcome/magic-link, etc). Domain
# verification isn't finished yet, so sendWelcomeEmail only calls the real
# API in production — dev/test always log the magic link instead.
RESEND_API_KEY=

# REQUIRED. Verified-domain sender for every transactional email, e.g.
# "FlightAgent <alerts@flightagent.io>". No fallback: the app fails fast
# (layout + guardian cron) when this is missing.
NOTIFICATION_FROM_EMAIL=

# REQUIRED. Public base URL of this deployment (no trailing slash), e.g.
# https://flightagent.io. Every absolute link in emails, Stripe redirects and
# billing-portal return URLs is built from it. Fail-fast when missing.
APP_BASE_URL=

# Resend Inbound Webhook signing secret (Resend Dashboard > Webhooks > Signing Secret).
# Required in production to verify that webhook requests genuinely come from Resend.
# Format: whsec_<base64-encoded-secret>
RESEND_WEBHOOK_SECRET=

# Shared secret required in INTERNAL_API_SECRET request header
# for /api/internal/health endpoints.
INTERNAL_API_SECRET=

# Stripe Checkout price IDs (required for /api/checkout)
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# Public Stripe key for client-side Stripe usage
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Back-office admin gate for /admin/claims
ADMIN_EMAIL=
