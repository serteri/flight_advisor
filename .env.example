# FlightAware AeroAPI key for server-side historical connection analysis.
FLIGHTAWARE_API_KEY=

# Shared secret required in INTERNAL_API_SECRET request header
# for /api/internal/health endpoints.
INTERNAL_API_SECRET=

# Stripe Checkout price IDs (required for /api/checkout)
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
